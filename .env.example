# OpenAI — used to generate personal letter messages
# If omitted, Little Letter uses warm local fallback templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- FREE email to ANY address (recommended for now) ---
# Use a normal Gmail account + App Password.
# Recipients will see: Little Letter <yourgmail@gmail.com>
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Little Letter

# Resend — optional later, after you buy/verify a custom domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=Little Letter <onboarding@resend.dev>

# Stripe — only used when payments are turned on
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payments are OFF by default (demo / free testing).
# Set to true when you want £0.50 charges after free sends.
# PAYMENTS_ENABLED=true

# Public site URL for metadata / Open Graph / Stripe return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
