# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Gmail (required for live site — stops spam) ---
#
# 1. Google Cloud → enable Gmail API → create OAuth Web client
# 2. Redirect URI: https://YOUR-SITE.vercel.app/api/gmail-setup/callback
# 3. Add test user: your sending Gmail (OAuth consent screen → Audience)
# 4. On Vercel set the vars below, redeploy
# 5. Visit: https://YOUR-SITE.vercel.app/api/gmail-setup?key=YOUR_SETUP_SECRET
# 6. Sign in → copy GMAIL_REFRESH_TOKEN to Vercel → redeploy again
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SETUP_SECRET=make-up-a-long-random-password

# Fallback only (worse inbox placement than Gmail API above):
GMAIL_APP_PASSWORD=

# Never set to "Little Letter"
GMAIL_FROM_NAME=

# Resend — only with a verified custom domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Postgres (Vercel/Supabase) — tracks free/paid sends by sender email
POSTGRES_URL=

NEXT_PUBLIC_SITE_URL=https://sendlittleletter.vercel.app

# YouTube Data API v3 — optional (song search works without it now).
# Enable “YouTube Data API v3” and add a key if you want the official API.
YOUTUBE_API_KEY=
# DEMO_MODE=true
