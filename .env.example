# OpenAI — used to generate personal letter messages
# If omitted, Little Letter uses warm local fallback templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resend — used to deliver the HTML email
# If omitted, sends are simulated successfully in demo mode.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Little Letter <onboarding@resend.dev>

# Public site URL for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
